<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor (Lecture 6/7: "web.xml ... though this is not
    necessary" in newer servlet versions; annotation-based @WebServlet
    could be used instead, but an explicit web.xml is used here so that
    every servlet's URL mapping, the welcome file, the session timeout
    and the error page are all declared in one place for the marker to
    read, matching the deployment-descriptor style shown in Lecture 6's
    worked example).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Sunrise Dental Clinic</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session times out after 30 minutes of inactivity (Lecture 7: HttpSession). -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

    <!-- ===================== Login / Logout ===================== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>dental.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>dental.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- ===================== Appointments ===================== -->
    <servlet>
        <servlet-name>RegisterAppointmentServlet</servlet-name>
        <servlet-class>dental.servlet.RegisterAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterAppointmentServlet</servlet-name>
        <url-pattern>/registerAppointment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewAppointmentServlet</servlet-name>
        <servlet-class>dental.servlet.ViewAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewAppointmentServlet</servlet-name>
        <url-pattern>/viewAppointment</url-pattern>
    </servlet-mapping>

    <!-- ===================== Patient directory / client history ===================== -->
    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>dental.servlet.PatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/patients</url-pattern>
    </servlet-mapping>

    <!-- ===================== Billing ===================== -->
    <servlet>
        <servlet-name>GenerateBillServlet</servlet-name>
        <servlet-class>dental.servlet.GenerateBillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GenerateBillServlet</servlet-name>
        <url-pattern>/generateBill</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrintReceiptServlet</servlet-name>
        <servlet-class>dental.servlet.PrintReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrintReceiptServlet</servlet-name>
        <url-pattern>/printReceipt</url-pattern>
    </servlet-mapping>

    <!-- ===================== Staff / Reports ===================== -->
    <servlet>
        <servlet-name>ManageStaffServlet</servlet-name>
        <servlet-class>dental.servlet.ManageStaffServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageStaffServlet</servlet-name>
        <url-pattern>/manageStaff</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>dental.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports</url-pattern>
    </servlet-mapping>

    <!-- ===================== Web service (AJAX/JSON) ===================== -->
    <servlet>
        <servlet-name>TreatmentCostServlet</servlet-name>
        <servlet-class>dental.servlet.TreatmentCostServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TreatmentCostServlet</servlet-name>
        <url-pattern>/treatmentCost</url-pattern>
    </servlet-mapping>

</web-app>
